{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "legacy": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/legacy",
      "sourceRoot": "projects/legacy/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/legacy/src/main.ts",
            "tsConfig": "projects/legacy/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/legacy/public"
              }
            ],
            "styles": [
              "projects/legacy/src/styles.css"
            ],
            "polyfills": [
              "zone.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "legacy:build:production"
            },
            "development": {
              "buildTarget": "legacy:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "modern": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/modern",
      "sourceRoot": "projects/modern/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/modern/src/main.ts",
            "tsConfig": "projects/modern/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/modern/public"
              }
            ],
            "styles": [
              "projects/modern/src/styles.css"
            ],
            "server": "projects/modern/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ]
            },
            "ssr": {
              "entry": "projects/modern/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "modern:build:production"
            },
            "development": {
              "buildTarget": "modern:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
